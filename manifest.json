{
  "manifest_version": 3,
  "name": "TranslateFlow",
  "version": "0.5.0",
  "description": "AI web translation with DeepSeek and OpenAI-compatible providers, site profiles, URL-aware IndexedDB cache and automatic incremental translation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TranslateFlow",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "96"
}
