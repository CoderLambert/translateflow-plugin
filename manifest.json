{
  "manifest_version": 3,
  "name": "AI Bilingual Translator",
  "version": "0.3.0",
  "description": "Bilingual web translation with DeepSeek, URL-aware IndexedDB cache and per-site automatic incremental translation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Bilingual Translator",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "96"
}
