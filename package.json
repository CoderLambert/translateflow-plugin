{
  "name": "translateflow-plugin",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run check && npm test && npm run build:extension",
    "benchmark:translation": "node scripts/benchmark-translation.mjs",
    "test:e2e": "playwright test",
    "build:tflex:core": "node scripts/build-tflex-core.mjs",
    "build:tflex:technical": "node scripts/build-tflex-technical.mjs",
    "evaluate:lexical": "node scripts/evaluate-lexical-ranking.mjs",
    "build:lexicon:release": "node scripts/build-release-lexicon.mjs",
    "certify:lexicon": "node scripts/certify-lexical-release.mjs",
    "build:tflex:freedict": "node scripts/build-tflex-freedict.mjs",
    "lock:kaikki": "node scripts/lock-kaikki-source.mjs",
    "setup:lexicon": "node scripts/setup-lexicon.mjs",
    "benchmark:lexical": "node scripts/benchmark-lexical-quality.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:release": "node scripts/build-extension.mjs --require-lexicon",
    "evaluate:bootstrap": "node scripts/evaluate-core-bootstrap.mjs",
    "measure:extension-footprint": "node scripts/measure-extension-footprint.mjs",
    "project:kaikki": "node scripts/project-kaikki-rich.mjs",
    "ingest:wiktextract": "python3 scripts/run-pinned-wiktextract-ingest.py",
    "audit:wiktextract-rich": "node scripts/audit-wiktextract-projection-compatibility.mjs",
    "certify:selection-lexical": "node scripts/certify-integrated-lexical-quality.mjs",
    "project:stardict": "node scripts/project-stardict-import.mjs",
    "project:mdict": "node scripts/project-mdict-import.mjs",
    "build:tflex:mdict-import": "node scripts/build-tflex-mdict-import.mjs",
    "build:tflex:stardict-import": "node scripts/build-tflex-stardict-import.mjs",
    "measure:stardict-import": "node scripts/measure-stardict-import-cost.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
