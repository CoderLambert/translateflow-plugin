{
  "name": "translateflow-plugin",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs && npm run check:i18n",
    "check:i18n": "node scripts/i18n-locales.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run check && npm test && npm run typecheck && npm run test:unit && npm run build:extension",
    "benchmark:translation": "node scripts/benchmark-translation.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build:tflex:core": "node scripts/build-tflex-core.mjs",
    "build:tflex:technical": "node scripts/build-tflex-technical.mjs",
    "evaluate:lexical": "node scripts/evaluate-lexical-ranking.mjs",
    "build:lexicon:release": "node scripts/build-release-lexicon.mjs",
    "certify:lexicon": "node scripts/certify-lexical-release.mjs",
    "certify:offline-dictionary-beta": "node scripts/certify-offline-dictionary-beta.mjs",
    "certify:dictionary-library-vnext": "node scripts/certify-vnext-dictionary-library.mjs",
    "certify:dictionary-ecosystem-v2": "node scripts/certify-dictionary-ecosystem-v2.mjs",
    "build:tflex:freedict": "node scripts/build-tflex-freedict.mjs",
    "lock:kaikki": "node scripts/lock-kaikki-source.mjs",
    "setup:lexicon": "node scripts/setup-lexicon.mjs",
    "benchmark:lexical": "node scripts/benchmark-lexical-quality.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:release": "node scripts/build-extension.mjs --require-lexicon",
    "evaluate:bootstrap": "node scripts/evaluate-core-bootstrap.mjs",
    "measure:extension-footprint": "node scripts/measure-extension-footprint.mjs",
    "project:kaikki": "node scripts/project-kaikki-rich.mjs",
    "ingest:wiktextract": "python3 scripts/run-pinned-wiktextract-ingest.py",
    "audit:wiktextract-rich": "node scripts/audit-wiktextract-projection-compatibility.mjs",
    "certify:selection-lexical": "node scripts/certify-integrated-lexical-quality.mjs",
    "project:stardict": "node scripts/project-stardict-import.mjs",
    "project:mdict": "node scripts/project-mdict-import.mjs",
    "build:tflex:mdict-import": "node scripts/build-tflex-mdict-import.mjs",
    "build:tflex:stardict-import": "node scripts/build-tflex-stardict-import.mjs",
    "measure:stardict-import": "node scripts/measure-stardict-import-cost.mjs",
    "certify:rich-mdict-corpus": "node scripts/certify-rich-mdict-corpus.mjs",
    "inspect:mdict": "node scripts/inspect-mdict-compatibility.mjs",
    "test:rich-mdict-security": "node --test tests/rich-mdict-security.test.mjs",
    "test:rich-lookup-cancellation": "node --test tests/rich-mdict-lookup-cancellation.test.mjs",
    "test:e2e:rich-mdict": "node scripts/run-e2e.mjs e2e/rich-mdict-product.spec.mjs e2e/rich-mdict-real-corpus.spec.mjs",
    "prepare": "wxt prepare",
    "dev": "wxt -b chrome --mv3",
    "build:extension:wxt": "wxt build -b chrome --mv3 && node scripts/audit-wxt-extension.mjs",
    "test:wxt:smoke": "node scripts/smoke-wxt-extension.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:unit": "wxt prepare && vitest run"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "packageManager": "npm@11.19.0"
}
