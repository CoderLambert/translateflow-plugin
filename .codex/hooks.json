{
  "description": "Local task efficiency metadata only. No model calls or context injection.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 3}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "PreToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "PostToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "PermissionRequest": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "SubagentStart": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "SubagentStop": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "PreCompact": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "PostCompact": [{"matcher": ".*", "hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 5}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/task-execution.mjs\" hook", "timeout": 3}]}]
  }
}
